  async function placeOrder(
    event: React.FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (cart.length === 0) {
      return;
    }

    const submitter = (
      event.nativeEvent as SubmitEvent
    ).submitter as HTMLButtonElement | null;

    const contactAfterOrder =
      submitter?.dataset.whatsappOrder === "true";

    // Open WhatsApp immediately from the user's click
    // so the browser does not block the popup after the async save.
    const whatsappWindow = contactAfterOrder
      ? window.open("about:blank", "_blank")
      : null;

    // Check current stock before creating the order
    const productIds = cart.map((item) => Number(item.id));

    const { data: products, error: stockCheckError } = await supabase
      .from("products")
      .select("id, name, stock")
      .in("id", productIds);

    if (stockCheckError) {
      console.error("Failed to check stock:", stockCheckError);

      alert(
        language === "sw"
          ? "Imeshindikana kuthibitisha stock. Tafadhali jaribu tena."
          : "Unable to verify stock. Please try again."
      );

      return;
    }

    for (const item of cart) {
      const product = products?.find(
        (p) => Number(p.id) === Number(item.id)
      );

      const availableStock = Number(product?.stock || 0);
      const requestedQuantity = Number(item.quantity || 0);

      if (!product || availableStock < requestedQuantity) {
        alert(
          language === "sw"
            ? `${item.name} ina stock ${availableStock} tu. Umeomba ${requestedQuantity}. Tafadhali punguza quantity.`
            : `${item.name} has only ${availableStock} in stock. You requested ${requestedQuantity}. Please reduce the quantity.`
        );

        return;
      }
    }

    if (
      deliveryMethod === "delivery" &&
      (latitude === null || longitude === null)
    ) {
      alert(
        language === "sw"
          ? "Tafadhali pata location yako kwanza."
          : "Please get your location first."
      );

      return;
    }

    const newOrderNumber =
      "GAM-" + Date.now().toString().slice(-8);

    const order = {
      id: newOrderNumber,

      customer: {
        name,
        phone,
        email,
        address,
        notes,
      },

      location:
        deliveryMethod === "delivery" &&
        latitude !== null &&
        longitude !== null
          ? {
              latitude,
              longitude,
            }
          : null,

      distanceKm:
        deliveryMethod === "delivery"
          ? distanceKm
          : null,

      deliveryFee:
        deliveryMethod === "pickup"
          ? 0
          : deliveryFee,

      deliveryMethod,

      items: cart,

      subtotal,

      total:
        deliveryMethod === "pickup"
          ? subtotal
          : total,

      status: "Pending",

      createdAt: new Date().toISOString(),
    };

    try {
      const response = await fetch("/api/orders", {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify(order),
      });

      if (!response.ok) {
        throw new Error("Failed to save order");
      }

      localStorage.removeItem("gamora_cart");

      setOrderNumber(newOrderNumber);
      setOrderPlaced(true);

      if (contactAfterOrder && whatsappWindow) {
        const whatsappText =
          subtotal <= 20000
            ? `Hello GAMORA ONLINE,

I have placed order ${newOrderNumber} and would like to negotiate the product price.

Customer: ${name || "Not provided"}
