  async function getLocation() {
    setLocationError("");
    setRouteError("");
    setLocationLoading(true);
    setOutsideDar(false);
    setSelectedLocationName("");

    if (!navigator.geolocation) {
      setLocationError(
        language === "sw"
          ? "Simu/browser yako haisapoti GPS location."
          : "Your phone/browser does not support GPS location."
      );
      setLocationLoading(false);
      return;
    }

    const success = async (
      position: GeolocationPosition
    ) => {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;

      console.log("GPS LOCATION:", lat, lng);

      setLatitude(lat);
      setLongitude(lng);
      setLocationLoading(false);

      /*
       * GPS does not tell us the city name reliably,
       * so reverse-geocode it first.
       */
      try {
        const response = await fetch(
          "https://nominatim.openstreetmap.org/reverse?format=json&addressdetails=1&lat=" +
            encodeURIComponent(String(lat)) +
            "&lon=" +
            encodeURIComponent(String(lng)),
          {
            headers: {
              Accept: "application/json",
            },
          }
        );

        const result = await response.json();
        const resultAddress = result?.address || {};

        const locationText = [
          resultAddress.road,
          resultAddress.neighbourhood,
          resultAddress.suburb,
          resultAddress.city_district,
          resultAddress.city,
          resultAddress.town,
          resultAddress.state,
        ]
          .filter(Boolean)
          .join(", ");

        const displayName =
          result?.display_name ||
          locationText ||
          "Current location";

        const searchableLocation = [
          result?.display_name || "",
          resultAddress.city || "",
          resultAddress.town || "",
          resultAddress.municipality || "",
          resultAddress.county || "",
          resultAddress.state || "",
        ]
          .join(" ")
          .toLowerCase();

        const isDar =
          searchableLocation.includes("dar es salaam") ||
          searchableLocation.includes("dar-es-salaam");

        setSelectedLocationName(displayName);

        console.log("GPS REVERSE LOCATION:", {
          displayName,
          isDar,
          latitude: lat,
          longitude: lng,
        });

        if (!isDar) {
          setOutsideDar(true);
          setDistanceKm(null);
          setDeliveryFee(0);

          setLocationError(
            language === "sw"
              ? "Uko nje ya Dar es Salaam. Unaweza kuweka order; tutathibitisha gharama ya delivery kupitia mhudumu wa usafiri."
              : "You are outside Dar es Salaam. You can place the order and our staff will confirm the delivery cost through the transport service."
          );

          return;
        }

        setOutsideDar(false);
        await calculateRoadDistance(lat, lng);
      } catch (error) {
        console.error(
          "GPS reverse geocoding failed:",
          error
        );

        /*
         * If reverse geocoding fails, use the GPS
         * coordinates for the road calculation.
         */
        setOutsideDar(false);
        await calculateRoadDistance(lat, lng);
      }
    };

    const failed = (
      error: GeolocationPositionError
    ) => {
      console.error(
        "Browser location failed:",
        error.code,
        error.message
      );

      let message =
        language === "sw"
          ? "Hatukuweza kupata location yako."
          : "We could not get your location.";

      if (error.code === 1) {
        message =
          language === "sw"
            ? "Location imekataliwa. Bonyeza Allow kwenye permission ya browser, kisha ujaribu tena."
            : "Location permission was denied. Allow location permission in your browser and try again.";
      } else if (error.code === 2) {
        message =
          language === "sw"
            ? "Simu haikuweza kupata GPS location. Washa GPS/Location kwenye simu kisha ujaribu tena."
            : "Your phone could not determine your GPS location. Turn on Location/GPS and try again.";
      } else if (error.code === 3) {
        message =
          language === "sw"
            ? "GPS imechukua muda mrefu. Jaribu tena ukiwa sehemu yenye signal nzuri."
            : "GPS took too long. Try again where you have a better location signal.";
      }

      setLocationError(message);
      setLocationLoading(false);
    };

    navigator.geolocation.getCurrentPosition(
      success,
      (error) => {
        console.warn(
          "High accuracy GPS failed:",
          error.code,
          error.message
        );

        navigator.geolocation.getCurrentPosition(
          success,
          failed,
          {
            enableHighAccuracy: false,
            timeout: 20000,
            maximumAge: 300000,
          }
        );
      },
      {
        enableHighAccuracy: true,
        timeout: 15000,
        maximumAge: 60000,
      }
    );
  }

