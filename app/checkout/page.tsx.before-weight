      );
      return;
    }

    setLocationError("");
    setRouteError("");
    setLocationLoading(true);
    setOutsideDar(false);
    setLatitude(null);
    setLongitude(null);
    setDistanceKm(null);
    setDeliveryFee(0);
    setSelectedLocationName("");

    try {
      /*
       * IMPORTANT:
       * Do not force every search into Dar es Salaam.
       * Search Tanzania generally so locations outside
       * Dar can also be detected correctly.
       */
      const response = await fetch(
        "https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=8&countrycodes=tz&q=" +
          encodeURIComponent(query) +
          "&dedupe=1&accept-language=en&_" +
          Date.now(),
        {
          cache: "no-store",
          headers: {
            Accept: "application/json",
          },
        }
      );

      if (!response.ok) {
        throw new Error("Location search failed");
      }

      const results = await response.json();

      if (!Array.isArray(results) || results.length === 0) {
        throw new Error("Location not found");
      }

      /*
       * Prefer a result that is actually inside
       * Dar es Salaam when the user typed a Dar
       * landmark/area.
       */
      const darResult = results.find((result: any) => {
        const address = result?.address || {};

        const text = [
          result?.display_name || "",
          address?.city || "",
          address?.town || "",
          address?.municipality || "",
          address?.county || "",
          address?.state || "",
        ]
          .join(" ")
          .toLowerCase();

        return (
          text.includes("dar es salaam") ||
          text.includes("dar-es-salaam")
        );
      });

      /*
       * Select the best Tanzania result.
       *
       * Priority:
       * 1. Dar es Salaam result when available.
       * 2. Otherwise the first Tanzania result.
       *
       * This keeps searches such as Buza, Mbezi,
       * Mikocheni, Masaki, etc. working without
       * maintaining a manual list of locations.
       */
      const result = darResult || results[0];

      const lat = Number(result.lat);
      const lng = Number(result.lon);

      if (
        !Number.isFinite(lat) ||
        !Number.isFinite(lng)
      ) {
        throw new Error("Invalid coordinates");
      }

      const resultAddress = result.address || {};

      const locationText = [
        resultAddress.road,
        resultAddress.neighbourhood,
        resultAddress.suburb,
        resultAddress.city_district,
        resultAddress.city,
        resultAddress.town,
        resultAddress.state,
        resultAddress.region,
      ]
        .filter(Boolean)
        .join(", ");

      const displayName =
        result.display_name ||
        locationText ||
        query;

      /*
       * Confirm the result is actually in Tanzania.
       */
      const countryCode = String(
        resultAddress.country_code || ""
      ).toLowerCase();

      const countryName = String(
        resultAddress.country || ""
      ).toLowerCase();

      const isTanzania =
        countryCode === "tz" ||
        countryName === "tanzania" ||
        countryName.includes("tanzania");

      /*
       * Determine whether the selected result
       * belongs to Dar es Salaam.
       */
      const searchableLocation = [
        result.display_name || "",
        resultAddress.city || "",
        resultAddress.town || "",
        resultAddress.municipality || "",
        resultAddress.county || "",
        resultAddress.state || "",
        resultAddress.region || "",
      ]
        .join(" ")
        .toLowerCase();

      const isDar =
        searchableLocation.includes("dar es salaam") ||
        searchableLocation.includes("dar-es-salaam");

      if (!isTanzania) {
        throw new Error("Location is outside Tanzania");
      }

      console.log("LOCATION SEARCH RESULT:", {
        query,
        displayName,
        locationText,
        latitude: lat,
        longitude: lng,
        isDar,
        address: resultAddress,
      });

      setLatitude(lat);
      setLongitude(lng);
      setSelectedLocationName(displayName);
      setLocationError("");

      if (!isDar) {
        /*
         * Outside Dar:
         * Do not calculate a fake local delivery fee.
         * The order can continue, but staff will confirm
         * the transport/bus delivery cost.
         */
        setOutsideDar(true);
        setDistanceKm(null);
        setDeliveryFee(0);
        setRouteError("");

        setLocationError(
          language === "sw"
            ? "Eneo hili liko nje ya Dar es Salaam. Weka order; tutathibitisha gharama ya delivery kupitia mhudumu wa usafiri."
            : "This location is outside Dar es Salaam. Place your order and our staff will confirm the delivery cost through the transport service."
        );

        return;
      }

      setOutsideDar(false);

      await calculateRoadDistance(lat, lng);
    } catch (error) {
      console.error(
        "Address location failed:",
        error
      );

      setLatitude(null);
      setLongitude(null);
      setDistanceKm(null);
      setDeliveryFee(0);
      setOutsideDar(false);
      setSelectedLocationName("");

      setLocationError(
        language === "sw"
          ? "Hatukuweza kupata eneo hilo. Andika landmark/sehemu maarufu iliyo karibu nawe, mfano Sinza Madukani, Mlimani City, Mwenge, Mbezi au Shekilango."
          : "We could not find that location. Try a nearby landmark, such as Sinza Madukani, Mlimani City, Mwenge, Mbezi or Shekilango."
      );
    } finally {
      setLocationLoading(false);
    }
