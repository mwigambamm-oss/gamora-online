  async function calculateRoadDistance(
    lat: number,
    lng: number
  ) {
    setRouteLoading(true);
    setRouteError("");

    try {
      /*
       * GAMORA DELIVERY DISTANCE
       *
       * We use map coordinates instead of OSRM road routing.
       * Kariakoo -> Sinza Madukani:
       * straight-line ≈ 6.34 km
       * reference road distance ≈ 7.1 km
       *
       * Calibration factor = 7.1 / 6.34 ≈ 1.12
       */
      const straightDistance = calculateStraightDistance(
        KARIAKOO.lat,
        KARIAKOO.lng,
        lat,
        lng
      );

      const calibratedDistance = straightDistance * 1.12;

      setDistanceKm(calibratedDistance);
      setDeliveryFee(
        calculateDeliveryFee(calibratedDistance)
      );

      console.log("DELIVERY DISTANCE:", {
        straightDistance,
        calibratedDistance,
        deliveryFee: calculateDeliveryFee(
          calibratedDistance
        ),
      });
    } catch (error) {
      console.error(
        "Distance calculation failed:",
        error
      );

      setDistanceKm(null);
      setDeliveryFee(0);

      setRouteError(
        language === "sw"
          ? "Hatukuweza kupima umbali. Tafadhali jaribu tena."
          : "We could not calculate the distance. Please try again."
      );
    } finally {
      setRouteLoading(false);
    }
  }

  async function getLocationByAddress() {
    const query = address.trim();

    if (!query) {
      setLocationError(
        language === "sw"
          ? "Andika eneo au sehemu maarufu iliyo karibu nawe, mfano Sinza Madukani, Mlimani City, Mwenge au Shekilango."
