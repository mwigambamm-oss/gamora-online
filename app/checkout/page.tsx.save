              <div className="flex justify-between gap-4">
                <span className="text-slate-600">
                  {t.subtotal}
                </span>

                <span className="font-bold">
                  TZS {subtotal.toLocaleString()}
                </span>
              </div>

              <div className="flex justify-between gap-4">
                <span className="text-slate-600">
                  {t.delivery}
                </span>

                <span className="font-bold text-sky-700">
                  {distanceKm === null
                    ? t.calculateFirst
                    : `TZS ${deliveryFee.toLocaleString()}`}
                </span>
              </div>

              <div className="border-t pt-5">

                <div className="flex justify-between gap-4">

                  <span className="text-xl font-black">
                    {t.total}
                  </span>

                  <span className="text-xl font-black text-sky-700">
                    TZS {total.toLocaleString()}
                  </span>

                </div>

              </div>

            </div>

            <button
              type="submit"
              disabled={distanceKm === null}
              className="mt-7 w-full rounded-lg bg-sky-700 px-6 py-4 font-black text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:bg-slate-300"
            >
              {t.placeOrder}
            </button>

            {distanceKm === null && (
              <p className="mt-3 text-center text-xs text-slate-500">
                {t.calculateFirst}
              </p>
            )}

            <a
              href="/cart"
              className="mt-3 block rounded-lg border border-slate-200 px-6 py-4 text-center font-bold hover:bg-slate-50"
            >
              {t.backCart}
            </a>

          </aside>

        </form>

      </section>

      {/* FOOTER */}
      <footer className="bg-sky-950 px-4 py-10 text-center text-sky-200">

        <div className="text-xl font-black text-white">
          GAMORA
          <span className="text-sky-300">ONLINE</span>
        </div>

        <p className="mt-3 text-sm">
          📍 Kariakoo, Dar es Salaam, Tanzania
        </p>

        <p className="mt-1 text-sm">
          ☎️ +255 798 555 221
        </p>

        <a
          href="/"
          className="mt-6 inline-block font-bold text-white hover:text-sky-300"
        >
          {t.backHome}
        </a>

        <div className="mt-8 border-t border-sky-800 pt-6 text-xs">
          © {new Date().getFullYear()} GAMORA ONLINE. All rights reserved.
        </div>

      </footer>

    </main>
  );
}
