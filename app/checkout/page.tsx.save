
"use client";

import { useEffect, useMemo, useState } from "react";

type CartItem = {
  id: number;
  name: string;
  price: number;
  quantity: number;
  image?: string;
};

type Order = {
  id: string;
  customer: {
    name: string;
    phone: string;
    email: string;
    address: string;
    notes: string;
  };
  location: {
    latitude: number;
    longitude: number;
  } | null;
  distanceKm: number | null;
  deliveryFee: number;
  items: CartItem[];
  subtotal: number;
  total: number;
  status: string;
  createdAt: string;
};

const KARIAKOO = {
  lat: -6.8235,
  lng: 39.2695,
};

function calculateDistance(
  lat1: number,
  lon1: number,
  lat2: number,
  lon2: number
) {
  const earthRadius = 6371;

  const dLat = ((lat2 - lat1) * Math.PI) / 180;
  const dLon = ((lon2 - lon1) * Math.PI) / 180;

  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos((lat1 * Math.PI) / 180) *
      Math.cos((lat2 * Math.PI) / 180) *
      Math.sin(dLon / 2) *
      Math.sin(dLon / 2);

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

  return earthRadius * c;
}

function calculateDeliveryFee(distanceKm: number) {
  if (distanceKm <= 2) return 3000;
  if (distanceKm <= 5) return 5000;
  if (distanceKm <= 8) return 7000;
  if (distanceKm <= 12) return 10000;
  if (distanceKm <= 18) return 15000;
  if (distanceKm <= 25) return 20000;

  return 25000;
}

export default function CheckoutPage() {
  const [language, setLanguage] = useState<"sw" | "en">("sw");

  const [cart, setCart] = useState<CartItem[]>([]);

  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [email, setEmail] = useState("");
  const [address, setAddress] = useState("");
  const [notes, setNotes] = useState("");

  const [latitude, setLatitude] = useState<number | null>(null);
  const [longitude, setLongitude] = useState<number | null>(null);

  const [locationLoading, setLocationLoading] = useState(false);
  const [locationError, setLocationError] = useState("");

  const [orderPlaced, setOrderPlaced] = useState(false);
  const [orderNumber, setOrderNumber] = useState("");

  useEffect(() => {
    try {
      const saved = localStorage.getItem("gamora_cart");

      if (saved) {
        const parsed = JSON.parse(saved);

        if (Array.isArray(parsed)) {
          setCart(parsed);
        }
      }
    } catch {
      setCart([]);
    }
  }, []);

  const subtotal = useMemo(() => {
    return cart.reduce(
      (sum, item) => sum + item.price * item.quantity,
      0
    );
  }, [cart]);

  const distanceKm = useMemo(() => {
    if (latitude === null || longitude === null) {
      return null;
    }

    return calculateDistance(
      KARIAKOO.lat,
      KARIAKOO.lng,
      latitude,
      longitude
    );
  }, [latitude, longitude]);

  const deliveryFee = useMemo(() => {
    if (distanceKm === null) {
      return 0;
    }

    return calculateDeliveryFee(distanceKm);
  }, [distanceKm]);

  const total = subtotal + deliveryFee;

  const sw = {
    title: "Checkout",
    subtitle: "Kamilisha taarifa za order yako",
    customerInfo: "Taarifa za Mteja",
    name: "Jina Kamili",
    phone: "Namba ya Simu",
    email: "Barua Pepe",
    address: "Address / Eneo",
    notes: "Maelezo ya ziada",
    optional: "(Hiari)",
    location: "Delivery Location",
    locationText:
      "Ruhusu location ili mfumo ukadirie distance kutoka Kariakoo.",
    getLocation: "Pata Location Yangu",
    gettingLocation: "Inatafuta Location...",
    locationFound: "Location imepatikana",
    locationError:
      "Hatukuweza kupata location yako. Hakikisha Location imewashwa kwenye browser.",
    distance: "Distance kutoka Kariakoo",
    delivery: "Delivery Fee",
    calculateFirst: "Pata Location kwanza",
    summary: "Order Summary",
    subtotal: "Jumla ya Bidhaa",
    total: "Jumla ya Order",
    placeOrder: "Weka Order",
    placing: "Inaweka Order...",
    empty: "Cart yako ipo tupu.",
    shop: "Endelea Shopping",
    success: "Order yako imepokelewa!",
    orderNumber: "Order Number",
    successText:
      "Asante kwa kuagiza GAMORA ONLINE. Tutawasiliana nawe kuthibitisha order na delivery.",
    backHome: "Rudi Home",
    backCart: "Rudi Cart",
  };

  const en = {
    title: "Checkout",
    subtitle: "Complete your order information",
    customerInfo: "Customer Information",
    name: "Full Name",
    phone: "Phone Number",
    email: "Email",
    address: "Address / Area",
    notes: "Additional Notes",
    optional: "(Optional)",
    location: "Delivery Location",
    locationText:
      "Allow location access so the system can estimate the distance from Kariakoo.",
    getLocation: "Get My Location",
    gettingLocation: "Getting Location...",
    locationFound: "Location found",
    locationError:
      "We could not get your location. Make sure Location is enabled in your browser.",
    distance: "Distance from Kariakoo",
    delivery: "Delivery Fee",
    calculateFirst: "Get Location First",
    summary: "Order Summary",
    subtotal: "Subtotal",
    total: "Order Total",
    placeOrder: "Place Order",
    placing: "Placing Order...",
    empty: "Your cart is empty.",
    shop: "Continue Shopping",
    success: "Your order has been received!",
    orderNumber: "Order Number",
    successText:
      "Thank you for ordering from GAMORA ONLINE. We will contact you to confirm your order and delivery.",
    backHome: "Back Home",
    backCart: "Back to Cart",
  };

  const t = language === "sw" ? sw : en;

async function getLocation() {
  setLocationError("");
  setLocationLoading(true);

  const useIpLocation = async () => {
    try {
      const response = await fetch("https://ipapi.co/json/");

      if (!response.ok) {
        throw new Error("IP location failed");
      }

      const data = await response.json();

      const lat = Number(data.latitude);
      const lng = Number(data.longitude);

      if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
        throw new Error("Invalid IP coordinates");
      }

      setLatitude(lat);
      setLongitude(lng);
      setLocationLoading(false);
    } catch (error) {
      console.error("IP location error:", error);
      setLocationError(t.locationError);
      setLocationLoading(false);
    }
  };

  if (!navigator.geolocation) {
    await useIpLocation();
    return;
  }

  navigator.geolocation.getCurrentPosition(
    (position) => {
      setLatitude(position.coords.latitude);
      setLongitude(position.coords.longitude);
      setLocationLoading(false);
    },
    async (error) => {
      console.warn(
        "Browser location failed:",
        error.code,
        error.message
      );

      await useIpLocation();
    },
    {
      enableHighAccuracy: false,
      timeout: 10000,
      maximumAge: 300000,
    }
  );
}

async function placeOrder(
  event: React.FormEvent<HTMLFormElement>
) {
  event.preventDefault();

  if (cart.length === 0) {
    return;
  }

  if (distanceKm === null) {
    setLocationError(t.locationError);
    return;
  }

  const newOrderNumber =
    "GAM-" + Date.now().toString().slice(-8);

  const order = {
    id: newOrderNumber,
    customer: {
      name,
      phone,
      email,
      address,
      notes,
    },
    location:
      latitude !== null && longitude !== null
        ? {
            latitude,
            longitude,
          }
        : null,
    distanceKm,
    deliveryFee,
    items: cart,
    subtotal,
    total,
    status: "Pending",
    createdAt: new Date().toISOString(),
  };

  try {
    const response = await fetch("/api/orders", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(order),
    });

    if (!response.ok) {
      throw new Error("Failed to save order");
    }

    localStorage.removeItem("gamora_cart");

    setOrderNumber(newOrderNumber);
    setOrderPlaced(true);
  } catch (error) {
    console.error("Failed to place order:", error);
    alert(
      "Order haikufanikiwa kuhifadhiwa. Tafadhali jaribu tena."
    );
  }
}

  if (orderPlaced) {
    return (
      <main className="min-h-screen bg-slate-50">

        <header className="border-b bg-white shadow-sm">
          <div className="mx-auto flex max-w-6xl items-center justify-between px-4 py-5">

            <a
              href="/"
              className="text-2xl font-black text-sky-700"
            >
              GAMORA
              <span className="text-sky-950">ONLINE</span>
            </a>

            <div className="flex gap-2">
              <button
                onClick={() => setLanguage("sw")}
                className={`rounded-lg px-3 py-2 text-xs font-bold ${
                  language === "sw"
                    ? "bg-sky-700 text-white"
                    : "bg-slate-100"
                }`}
              >
                🇹🇿 SW
              </button>

              <button
                onClick={() => setLanguage("en")}
                className={`rounded-lg px-3 py-2 text-xs font-bold ${
                  language === "en"
                    ? "bg-sky-700 text-white"
                    : "bg-slate-100"
                }`}
              >
                🇬🇧 EN
              </button>
            </div>

          </div>
        </header>

        <section className="mx-auto max-w-2xl px-4 py-20">

          <div className="rounded-3xl bg-white p-8 text-center shadow-lg md:p-12">

            <div className="text-7xl">
              ✅
            </div>

            <h1 className="mt-6 text-3xl font-black">
              {t.success}
            </h1>

            <div className="mt-6 rounded-xl bg-sky-50 p-5">

              <p className="text-sm font-bold text-slate-500">
                {t.orderNumber}
              </p>

              <p className="mt-2 text-2xl font-black text-sky-700">
                {orderNumber}
              </p>

            </div>

            <p className="mt-6 leading-7 text-slate-600">
              {t.successText}
            </p>

            <a
              href="/"
              className="mt-8 inline-block rounded-lg bg-sky-700 px-8 py-4 font-black text-white hover:bg-sky-800"
            >
              {t.backHome}
            </a>

          </div>

        </section>

      </main>
    );
  }

  if (cart.length === 0) {
    return (
      <main className="min-h-screen bg-slate-50">

        <section className="mx-auto max-w-2xl px-4 py-20">

          <div className="rounded-3xl bg-white p-10 text-center shadow-sm">

            <div className="text-7xl">
              🛒
            </div>

            <h1 className="mt-6 text-3xl font-black">
              {t.empty}
            </h1>

            <a
              href="/"
              className="mt-7 inline-block rounded-lg bg-sky-700 px-7 py-4 font-black text-white"
            >
              {t.shop}
            </a>

          </div>

        </section>

      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-50">

      {/* TOP BAR */}
      <div className="bg-sky-950 px-4 py-2 text-center text-sm text-white">
        🌊 GAMORA ONLINE • Kariakoo, Dar es Salaam
      </div>

      {/* HEADER */}
      <header className="border-b bg-white shadow-sm">

        <div className="mx-auto flex max-w-6xl items-center justify-between px-4 py-5">

          <a
            href="/"
            className="text-2xl font-black text-sky-700"
          >
            GAMORA
            <span className="text-sky-950">ONLINE</span>
          </a>

          <div className="flex gap-2">

            <button
              onClick={() => setLanguage("sw")}
              className={`rounded-lg px-3 py-2 text-xs font-bold ${
                language === "sw"
                  ? "bg-sky-700 text-white"
                  : "bg-slate-100"
              }`}
            >
              🇹🇿 SW
            </button>

            <button
              onClick={() => setLanguage("en")}
              className={`rounded-lg px-3 py-2 text-xs font-bold ${
                language === "en"
                  ? "bg-sky-700 text-white"
                  : "bg-slate-100"
              }`}
            >
              🇬🇧 EN
            </button>

          </div>

        </div>

      </header>

      {/* TITLE */}
      <section className="bg-gradient-to-br from-sky-950 via-sky-800 to-cyan-600">

        <div className="mx-auto max-w-5xl px-4 py-14 text-center text-white">

          <div className="text-6xl">
            🛍️
          </div>

          <h1 className="mt-4 text-4xl font-black">
            {t.title}
          </h1>

          <p className="mt-3 text-sky-100">
            {t.subtitle}
          </p>

        </div>

      </section>

      {/* CHECKOUT */}
      <section className="mx-auto max-w-6xl px-4 py-12">

        <form
          onSubmit={placeOrder}
          className="grid gap-8 lg:grid-cols-[1fr_380px]"
        >

          {/* CUSTOMER FORM */}
          <div className="space-y-6">

            <div className="rounded-2xl bg-white p-7 shadow-sm">

              <h2 className="text-2xl font-black">
                {t.customerInfo}
              </h2>

              <div className="mt-6 space-y-5">

                {/* NAME */}
                <div>

                  <label className="mb-2 block text-sm font-bold">
                    {t.name}
                  </label>

                  <input
                    type="text"
                    required
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    placeholder={t.name}
                    className="w-full rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  />

                </div>

                {/* PHONE */}
                <div>

                  <label className="mb-2 block text-sm font-bold">
                    {t.phone}
                  </label>

                  <input
                    type="tel"
                    required
                    value={phone}
                    onChange={(e) => setPhone(e.target.value)}
                    placeholder="+255..."
                    className="w-full rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  />

                </div>

                {/* EMAIL */}
                <div>

                  <label className="mb-2 block text-sm font-bold">
                    {t.email}{" "}
                    <span className="font-normal text-slate-400">
                      {t.optional}
                    </span>
                  </label>

                  <input
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="example@email.com"
                    className="w-full rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  />

                </div>

                {/* ADDRESS */}
                <div>

                  <label className="mb-2 block text-sm font-bold">
                    {t.address}
                  </label>

                  <textarea
                    required
                    value={address}
                    onChange={(e) => setAddress(e.target.value)}
                    rows={3}
                    placeholder="Mfano: Sinza, Ubungo..."
                    className="w-full resize-none rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  />

                </div>

                {/* NOTES */}
                <div>

                  <label className="mb-2 block text-sm font-bold">
                    {t.notes}{" "}
                    <span className="font-normal text-slate-400">
                      {t.optional}
                    </span>
                  </label>

                  <textarea
                    value={notes}
                    onChange={(e) => setNotes(e.target.value)}
                    rows={3}
                    placeholder={
                      language === "sw"
                        ? "Mfano: Nipigie kabla ya kufika..."
                        : "Example: Call me before delivery..."
                    }
                    className="w-full resize-none rounded-lg border border-slate-200 px-4 py-3 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100"
                  />

                </div>

              </div>

            </div>

            {/* LOCATION */}
            <div className="rounded-2xl bg-white p-7 shadow-sm">

              <h2 className="text-2xl font-black">
                📍 {t.location}
              </h2>

              <p className="mt-3 leading-7 text-slate-500">
                {t.locationText}
              </p>

              <button
                type="button"
                onClick={getLocation}
                disabled={locationLoading}
                className="mt-6 rounded-lg bg-sky-700 px-6 py-4 font-black text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-60"
              >
                {locationLoading
                  ? t.gettingLocation
                  : t.getLocation}
              </button>

              {locationError && (
                <div className="mt-4 rounded-lg bg-red-50 p-4 text-sm font-medium text-red-700">
                  {locationError}
                </div>
              )}

              {distanceKm !== null && (
                <div className="mt-5 grid gap-4 sm:grid-cols-2">

                  <div className="rounded-xl bg-sky-50 p-5">
                    <p className="text-sm text-slate-500">
                      {t.distance}
                    </p>

                    <p className="mt-2 text-2xl font-black text-sky-700">
                      {distanceKm.toFixed(1)} km
                    </p>

                    <p className="mt-1 text-xs text-slate-500">
                      📍 Kariakoo → Your Location
                    </p>
                  </div>

                  <div className="rounded-xl bg-green-50 p-5">
                    <p className="text-sm text-slate-500">
                      {t.delivery}
                    </p>

                    <p className="mt-2 text-2xl font-black text-green-700">
                      TZS {deliveryFee.toLocaleString()}
                    </p>
                  </div>

                </div>
              )}

            </div>

          </div>

          {/* ORDER SUMMARY */}
          <aside className="h-fit rounded-2xl bg-white p-7 shadow-sm lg:sticky lg:top-6">

            <h2 className="text-2xl font-black">
              {t.summary}
            </h2>

            <div className="mt-6 space-y-4">

              {cart.map((item) => (

                <div
