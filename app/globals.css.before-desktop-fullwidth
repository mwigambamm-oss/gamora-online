@import "tailwindcss";

:root {
  --gamora-red: #E30613;
  --gamora-charcoal: #111827;
  --gamora-navy: #172033;
  --gamora-blue: #EEF5FF;
  --gamora-gray: #F6F7F9;
  --background: #F6F7F9;
  --foreground: #111827;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Inter, Geist, "Plus Jakarta Sans", Arial, Helvetica, sans-serif;
  font-size: 14px;
}

button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
img { max-width: 100%; }

.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar { display: none; }

.line-clamp-1 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.gamora-marquee {
  animation: gamora-marquee 28s linear infinite;
}
.gamora-marquee:hover { animation-play-state: paused; }

@keyframes gamora-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

::selection {
  background: #FEE2E2;
  color: #991B1B;
}


@keyframes gamoraCategoryUp {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(-50%);
  }
}

/* Prevent horizontal overflow on mobile */
html,
body {
  max-width: 100%;
  overflow-x: hidden;
}
