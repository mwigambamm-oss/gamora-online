              <div className="mt-5 space-y-4 text-sky-200">

                <p>
                  📍 <strong>{t.address}:</strong>
                  <br />
                  Kariakoo, Dar es Salaam, Tanzania
                </p>

                <p>
                  ☎️ <strong>{t.phone}:</strong>
                  <br />
                  +255 798 555 221
                </p>

                <p>
                  💬 WhatsApp:
                  <br />
                  +255 798 555 221
                </p>

              </div>

            </div>

          </div>

          {/* SOCIAL */}

          <div className="mt-12 border-t border-sky-800 pt-8">

