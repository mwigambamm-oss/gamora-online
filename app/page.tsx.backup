"use client";

import { useLanguage } from "@/components/providers/LanguageProvider";
import { useRouter } from "next/navigation";
import { FaFacebookF, FaInstagram, FaTiktok } from "react-icons/fa";
import { translations, type Language } from "@/lib/translations";
import { formatCurrency, type Currency } from "@/lib/currency";
import { getProducts as getSupabaseProducts, type Product } from "@/lib/products";
import {
  useEffect,
  useMemo,
  useRef,
  useState,
  type RefObject,
} from "react";

type CartItem = Product & { quantity: number };

const CATEGORY_IMAGES: Record<string, string> = {
  "Women's Fashion": "/images/womens-fashion.jpg",
  "Men's Fashion": "/images/mens-fashion.jpg",
  Shoes: "/images/shoes.jpg",
  "Phones & Electronics": "/images/phone.jpg",
  "Home & Kitchen": "/images/home-kitchen.jpg",
  Accessories: "/images/accessories.jpg",
  "Beauty & Personal Care": "/images/categories/beauty.jpg",
  "Computers & Accessories": "/images/categories/computers.jpg",
  "Baby & Kids": "/images/categories/baby.jpg",
  "Sports & Fitness": "/images/categories/sports.jpg",
  Automotive: "/images/categories/automotive.jpg",
  "Tools & Hardware": "/images/home-kitchen.jpg",
  "Books & Stationery": "/images/categories/books.jpg",
  "Jewelry & Watches": "/images/categories/jewelry.jpg",
  Furniture: "/images/categories/furniture.jpg",
  "Garden & Outdoor": "/images/categories/garden.jpg",
  "Health & Wellness": "/images/categories/health.jpg",
  Gaming: "/images/categories/gaming.jpg",
};



const ALL_CATEGORIES = [
  "Women's Fashion",
  "Men's Fashion",
  "Shoes",
  "Phones & Electronics",
  "Home & Kitchen",
  "Accessories",
  "Beauty & Personal Care",
  "Computers & Accessories",
  "Baby & Kids",
  "Sports & Fitness",
  "Automotive",
  "Tools & Hardware",
  "Books & Stationery",
  "Jewelry & Watches",
  "Furniture",
  "Garden & Outdoor",
  "Health & Wellness",
  "Gaming",
];

export default function HomePage() {
  const router = useRouter();
  const { language, setLanguage } = useLanguage();

  const [currency, setCurrency] = useState<Currency>("TZS");

  const [products, setProducts] = useState<Product[]>([]);
  const [search, setSearch] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("All");
  const [cartCount, setCartCount] = useState(0);
  const [heroIndex, setHeroIndex] = useState(0);
  const [heroPaused, setHeroPaused] = useState(false);
  const [notice, setNotice] = useState("");
  const [flashTime, setFlashTime] = useState("00:00:00");

  const flashRef = useRef<HTMLDivElement>(null);
  const trendingRef = useRef<HTMLDivElement>(null);
  const newRef = useRef<HTMLDivElement>(null);
  const bestRef = useRef<HTMLDivElement>(null);

  const t = translations[language];

  useEffect(() => {
    const saved = localStorage.getItem("gamora_currency");

    if (saved === "TZS" || saved === "USD") {
      setCurrency(saved);
    }
  }, []);

  useEffect(() => {
    localStorage.setItem("gamora_currency", currency);
  }, [currency]);

  useEffect(() => {
    const update = () => {
      const now = new Date();
      const end = new Date(now);

      end.setHours(23, 59, 59, 999);

      const diff = Math.max(0, end.getTime() - now.getTime());

      const hours = Math.floor(diff / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);

      setFlashTime(
        `${String(hours).padStart(2, "0")}:${String(minutes).padStart(
          2,
          "0"
        )}:${String(seconds).padStart(2, "0")}`
      );
    };

    update();

    const timer = window.setInterval(update, 1000);

  

  const marqueeStyle = `
    @keyframes gamora-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .gamora-marquee {
      animation: gamora-marquee 22s linear infinite;
    }

    .gamora-marquee:hover {
      animation-play-state: paused;
    }
  `;



  return () => window.clearInterval(timer);
  }, []);

  useEffect(() => {
    let active = true;

    async function loadProducts() {
      try {
        const data = await getSupabaseProducts();

        if (active) {
          setProducts(data);
        }
      } catch (error) {
        console.error("Failed to load products:", error);

        if (active) {
          setProducts([]);
        }
      }
    }

    loadProducts();
    updateCartCount();

    const update = () => updateCartCount();

    window.addEventListener("storage", update);
    window.addEventListener("gamora-cart-updated", update);

    return () => {
      active = false;
      window.removeEventListener("storage", update);
      window.removeEventListener("gamora-cart-updated", update);
    };
  }, []);

  useEffect(() => {
    if (heroPaused || heroSlides.length <= 1) return;

    const timer = window.setInterval(() => {
      setHeroIndex((current) => (current + 1) % heroSlides.length);
    }, 1000);

    return () => window.clearInterval(timer);
  });

  function updateCartCount() {
    const saved = localStorage.getItem("gamora_cart");

    if (!saved) {
      setCartCount(0);
      return;
    }

    try {
      const cart: CartItem[] = JSON.parse(saved);

      setCartCount(
        cart.reduce(
          (total, item) => total + Number(item.quantity || 0),
          0
        )
      );
    } catch {
      setCartCount(0);
    }
  }

  function changeLanguage(next: Language) {
    setLanguage(next);
    window.dispatchEvent(new Event("gamora-language-changed"));
  }

  function addToCart(product: Product) {
    const saved = localStorage.getItem("gamora_cart");

    let cart: CartItem[] = [];

    if (saved) {
      try {
        cart = JSON.parse(saved);
      } catch {
        cart = [];
      }
    }

    const existingIndex = cart.findIndex(
      (item) => item.id === product.id
    );

    if (existingIndex >= 0) {
      cart[existingIndex].quantity += 1;
    } else {
      cart.push({
        ...product,
        quantity: 1,
      });
    }

    localStorage.setItem("gamora_cart", JSON.stringify(cart));

    updateCartCount();

    window.dispatchEvent(new Event("gamora-cart-updated"));

    setNotice(
      language === "sw"
        ? `${product.name} imeongezwa kwenye kikapu.`
        : `${product.name} has been added to your cart.`
    );

    window.setTimeout(() => setNotice(""), 2200);
  }

  function scrollCarousel(
    ref: RefObject<HTMLDivElement | null>,
    direction: number
  ) {
    const el = ref.current;

    if (!el) return;

    el.scrollBy({
      left:
        direction *
        Math.max(320, Math.floor(el.clientWidth * 0.9)),
      behavior: "smooth",
    });
  }

  const categories = useMemo(() => {
    const found = Array.from(
      new Set(
        products
          .map((product) => product.category)
          .filter(Boolean)
      )
    );

    const extra = found.filter(
      (name) => !ALL_CATEGORIES.includes(name)
    );

    return [...ALL_CATEGORIES, ...extra];
  }, [products]);

  const filteredProducts = useMemo(() => {
    const query = search.toLowerCase().trim();

    return products.filter((product) => {
      const matchesSearch =
        !query ||
        product.name.toLowerCase().includes(query) ||
        product.category.toLowerCase().includes(query);

      const matchesCategory =
        selectedCategory === "All" ||
        product.category === selectedCategory;

      return matchesSearch && matchesCategory;
    });
  }, [products, search, selectedCategory]);

  const [productHubTab, setProductHubTab] = useState<
    "all" | "deals" | "thumbs"
  >("all");

  const deals = useMemo(
    () =>
      [...filteredProducts]
        .filter((product) => getDiscount(product) > 0)
        .sort(
          (a, b) => getDiscount(b) - getDiscount(a)
        )
        .slice(0, 20),
    [filteredProducts]
  );

  const trending = useMemo(
    () =>
      [...filteredProducts]
        .sort(
          (a, b) =>
            Number(b.orders_count || 0) -
            Number(a.orders_count || 0)
        )
        .slice(0, 20),
    [filteredProducts]
  );

  const productHubProducts = useMemo(() => {
    if (productHubTab === "deals") {
      return deals;
    }

    if (productHubTab === "thumbs") {
      return trending;
    }

    return filteredProducts.slice(0, 30);
  }, [productHubTab, filteredProducts, deals, trending]);

  const newArrivals = useMemo(
    () =>
      [...filteredProducts]
        .sort((a, b) => Number(b.id) - Number(a.id))
        .slice(0, 20),
    [filteredProducts]
  );


  // GAMORA BEST SELLERS AUTO SLIDER
  useEffect(() => {
    if (!trending.length) return;

    const slider = trendingRef.current;
    if (!slider) return;

    const timer = window.setInterval(() => {
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      if (maxScroll <= 0) return;

      if (slider.scrollLeft >= maxScroll - 20) {
        slider.scrollTo({
          left: 0,
          behavior: "smooth",
        });
      } else {
        slider.scrollBy({
          left: 220,
          behavior: "smooth",
        });
      }
    }, 3000);

    return () => window.clearInterval(timer);
  }, [trending.length]);

  // GAMORA NEW ARRIVALS AUTO SLIDER
  useEffect(() => {
    if (!newArrivals.length) return;

    const slider = newRef.current;
    if (!slider) return;

    const timer = window.setInterval(() => {
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      if (maxScroll <= 0) return;

      if (slider.scrollLeft >= maxScroll - 20) {
        slider.scrollTo({
          left: 0,
          behavior: "smooth",
        });
      } else {
        slider.scrollBy({
          left: 220,
          behavior: "smooth",
        });
      }
    }, 1000);

    return () => window.clearInterval(timer);
  }, [newArrivals.length]);

  // GAMORA PRODUCT HUB AUTO SLIDER
  useEffect(() => {
    if (!productHubProducts.length) return;

    const slider = flashRef.current;
    if (!slider) return;

    const timer = window.setInterval(() => {
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      if (maxScroll <= 0) return;

      if (slider.scrollLeft >= maxScroll - 20) {
        slider.scrollTo({
          left: 0,
          behavior: "smooth",
        });
      } else {
        slider.scrollBy({
          left: 280,
          behavior: "smooth",
        });
      }
    }, 3500);

    return () => window.clearInterval(timer);
  }, [productHubProducts.length, productHubTab]);

  const bestSellers = useMemo(
    () =>
      [...filteredProducts]
        .sort(
          (a, b) =>
            Number(b.orders_count || 0) -
            Number(a.orders_count || 0)
        )
        .slice(0, 20),
    [filteredProducts]
  );

  const categoryProducts = useMemo(() => {
    const result: Record<string, Product[]> = {};

    ALL_CATEGORIES.forEach((category) => {
      result[category] = products
        .filter(
          (product) => product.category === category
        )
        .slice(0, 12);
    });

    return result;
  }, [products]);

  const heroProducts = useMemo(() => {
    const withImages = products.filter(
      (product): product is Product => Boolean(getProductImage(product))
    );

    const dellIndex = withImages.findIndex((product) =>
      String(product.name || "")
        .toLowerCase()
        .includes("dell 22-inch led monitor")
    );

    if (dellIndex >= 0) {
      const dell = withImages[dellIndex];
      const others = withImages.filter(
        (_, index) => index !== dellIndex
      );

      return [others[0], dell, ...others.slice(1)].filter(
        (product): product is Product => Boolean(product)
      ).slice(0, 5);
    }

    return withImages.slice(0, 5);
  }, [products]);

  const heroSlides = [
    {
      eyebrow:
        language === "sw"
          ? "KARIBU GAMORA ONLINE"
          : "WELCOME TO GAMORA ONLINE",
      title:
        language === "sw"
          ? "Nunua smart. Chagua Gamora."
          : "Shop smart. Choose Gamora.",
      text:
        language === "sw"
          ? "Gundua maelfu ya bidhaa kwa bei nzuri na uzoefu rahisi wa kununua."
          : "Discover great products at great prices with a simple shopping experience.",
      button:
        language === "sw" ? "ANZA KUNUNUA" : "SHOP NOW",
      product: heroProducts[0],
    },
    {
      eyebrow:
        language === "sw"
          ? "BIDHAA MPYA"
          : "NEW ARRIVALS",
      title:
        language === "sw"
          ? "Vitu vipya vimefika."
          : "Fresh finds have arrived.",
      text:
        language === "sw"
          ? "Gundua bidhaa mpya zilizowekwa kwenye Gamora."
          : "Explore the latest products added to Gamora.",
      button:
        language === "sw"
          ? "ANGALIA MPYA"
          : "EXPLORE NEW",
      product:
        heroProducts[1] || heroProducts[0],
    },
    {
      eyebrow:
        language === "sw"
          ? "FLASH DEALS"
          : "FLASH DEALS",
      title:
        language === "sw"
          ? "Ofa kali za leo."
          : "Today's biggest deals.",
      text:
        language === "sw"
          ? "Pata punguzo kwenye bidhaa zilizochaguliwa kabla muda haujaisha."
          : "Save more on selected products before the deals end.",
      button:
        language === "sw"
          ? "ANGALIA OFA"
          : "VIEW DEALS",
      product:
        deals[0] ||
        heroProducts[2] ||
        heroProducts[0],
    },
  ];

  const hero = heroSlides[heroIndex] || heroSlides[0];

  function goCategory(category: string) {
    router.push(
      `/category/${encodeURIComponent(category)}`
    );
  }

  function handleHeroButton() {
    if (hero.product) {
      router.push(`/product/${hero.product.id}`);
      return;
    }

    document
      .getElementById("products")
      ?.scrollIntoView({
        behavior: "smooth",
      });
  }

  return (
    <main className="min-h-screen bg-[#f8fafc] text-slate-900">
      <style>{`
        @keyframes gamora-marquee {
          from { transform: translateX(100%); }
          to { transform: translateX(-100%); }
        }

        .gamora-marquee {
          animation: gamora-marquee 22s linear infinite;
        }

        .gamora-marquee:hover {
          animation-play-state: paused;
        }
      `}</style>

      {notice && (
        <div className="fixed left-1/2 top-5 z-[100] -translate-x-1/2 rounded-full bg-slate-950 px-5 py-3 text-xs font-bold text-white shadow-2xl">
          ✓ {notice}
        </div>
      )}

      {/* TOP MOVING ANNOUNCEMENT */}
      <div className="overflow-hidden bg-orange-500 text-white">
        <div className="mx-auto max-w-[1600px] overflow-hidden">
          <div className="gamora-marquee flex min-h-[36px] w-max items-center whitespace-nowrap px-4 text-[11px] font-black tracking-wide sm:text-xs">
            {language === "sw"
              ? "🔥 KARIBU GAMORA ONLINE — Oda bidhaa zako leo  •  🚚 Delivery ndani ya Dar es Salaam  •  💳 Lipa kwa urahisi  •  🎉 Ofa Maalum Zinaendelea  •  🔥 KARIBU GAMORA ONLINE"
              : "🔥 WELCOME TO GAMORA ONLINE — Order your products today  •  🚚 Delivery across Dar es Salaam  •  💳 Easy payment  •  🎉 Special offers available  •  🔥 WELCOME TO GAMORA ONLINE"}
          </div>
        </div>
      </div>

      {/* HEADER */}
      <header className="sticky top-0 z-50 border-b border-slate-100 bg-white/95 shadow-sm backdrop-blur-xl">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <div className="flex h-[68px] items-center gap-3 lg:h-[76px]">
            <button
              type="button"
              onClick={() => router.push("/")}
              className="shrink-0"
              aria-label="Gamora Online"
            >
              <img
                src="/gamora-logo.png"
                alt="Gamora Online"
                className="h-10 w-auto object-contain sm:h-12"
              />
            </button>

            {/* DESKTOP SEARCH */}
            <div className="hidden min-w-0 flex-1 lg:block">
              <div className="mx-auto flex h-11 max-w-2xl overflow-hidden rounded-full border-2 border-orange-100 bg-slate-50 transition focus-within:border-orange-400 focus-within:bg-white">
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder={
                    language === "sw"
                      ? "Unatafuta nini leo?"
                      : "What are you looking for today?"
                  }
                  className="min-w-0 flex-1 bg-transparent px-5 text-sm outline-none placeholder:text-slate-400"
                />
                <button
                  type="button"
                  className="w-14 bg-orange-500 text-white transition hover:bg-orange-600"
                  aria-label="Search"
                >
                  🔍
                </button>
              </div>
            </div>

            {/* DESKTOP CONTROLS */}
            <div className="hidden items-center gap-2 lg:flex">
              {/* LANGUAGE */}
              <div className="flex items-center rounded-full border border-slate-200 bg-slate-50 p-1">
                <button
                  type="button"
                  onClick={() => setLanguage("sw")}
                  className={`rounded-full px-2.5 py-1.5 text-[10px] font-black transition ${
                    language === "sw"
                      ? "bg-orange-500 text-white shadow-sm"
                      : "text-slate-600 hover:text-orange-600"
                  }`}
                >
                  SW
                </button>
                <button
                  type="button"
                  onClick={() => setLanguage("en")}
                  className={`rounded-full px-2.5 py-1.5 text-[10px] font-black transition ${
                    language === "en"
                      ? "bg-orange-500 text-white shadow-sm"
                      : "text-slate-600 hover:text-orange-600"
                  }`}
                >
                  EN
                </button>
              </div>

              {/* CURRENCY */}
              <div className="flex items-center rounded-full border border-slate-200 bg-slate-50 p-1">
                <button
                  type="button"
                  onClick={() => setCurrency("TZS")}
                  className={`rounded-full px-2.5 py-1.5 text-[10px] font-black transition ${
                    currency === "TZS"
                      ? "bg-orange-500 text-white shadow-sm"
                      : "text-slate-600 hover:text-orange-600"
                  }`}
                >
                  TZS
                </button>
                <button
                  type="button"
                  onClick={() => setCurrency("USD")}
                  className={`rounded-full px-2.5 py-1.5 text-[10px] font-black transition ${
                    currency === "USD"
                      ? "bg-orange-500 text-white shadow-sm"
                      : "text-slate-600 hover:text-orange-600"
                  }`}
                >
                  USD
                </button>
              </div>

              <button
                type="button"
                onClick={() => router.push("/account")}
                className="flex items-center gap-2 rounded-full px-3 py-2 text-xs font-bold text-slate-700 hover:bg-orange-50 hover:text-orange-600"
              >
                <span className="text-lg">👤</span>
                <span>{language === "sw" ? "Akaunti" : "Account"}</span>
              </button>

              <button
                type="button"
                onClick={() => router.push("/cart")}
                className="relative flex items-center gap-2 rounded-full bg-slate-950 px-4 py-2.5 text-xs font-black text-white transition hover:bg-orange-500"
              >
                🛒
                <span>{language === "sw" ? "Kikapu" : "Cart"}</span>
                {cartCount > 0 && (
                  <span className="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-orange-500 px-1 text-[9px] font-black text-white">
                    {cartCount}
                  </span>
                )}
              </button>
            </div>

            {/* MOBILE CART */}
            <button
              type="button"
              onClick={() => router.push("/cart")}
              className="relative ml-auto flex h-10 w-10 items-center justify-center rounded-full bg-slate-950 text-white lg:hidden"
              aria-label="Cart"
            >
              🛒
              {cartCount > 0 && (
                <span className="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-orange-500 px-1 text-[9px] font-black">
                  {cartCount}
                </span>
              )}
            </button>
          </div>

          {/* MOBILE SEARCH */}
          <div className="pb-3 lg:hidden">
            <div className="flex h-11 overflow-hidden rounded-full border border-slate-200 bg-slate-50 focus-within:border-orange-400 focus-within:bg-white">
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder={
                  language === "sw"
                    ? "Tafuta bidhaa..."
                    : "Search products..."
                }
                className="min-w-0 flex-1 bg-transparent px-4 text-xs outline-none"
              />
              <button
                type="button"
                className="w-12 bg-orange-500 text-white"
              >
                🔍
              </button>
            </div>
          </div>
        </div>

        {/* NAVIGATION */}
        <div className="hidden border-t border-slate-100 lg:block">
          <div className="mx-auto flex max-w-[1600px] items-center gap-7 overflow-x-auto px-6 py-3 lg:px-8">
            {[
              ["HOME", "#top"],
              ["FLASH DEALS", "#flash-sales"],
              ["NEW ARRIVALS", "#new-arrivals"],
              ["BEST SELLERS", "#best-sellers"],
              ["CONTACT US", "#footer"],
            ].map(([label, target]) => (
              <a
                key={label}
                href={target}
                className="whitespace-nowrap text-[10px] font-black tracking-wide text-slate-600 transition hover:text-orange-600"
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </header>

      {/* HERO */}
      <section id="top" className="overflow-hidden bg-white">
        <div className="mx-auto max-w-[1600px] px-4 py-5 sm:px-6 sm:py-7 lg:px-8 lg:py-8">
          <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_280px]">
            
            {/* HERO CAMPAIGN */}
            <div className="relative min-h-[350px] overflow-hidden rounded-3xl bg-gradient-to-br from-orange-50 via-white to-teal-50 p-6 shadow-sm sm:min-h-[410px] sm:p-9 lg:min-h-[450px]">
              <div className="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-orange-200/30 blur-3xl" />
              <div className="absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-teal-200/30 blur-3xl" />

              <div className="relative z-10 grid h-full items-center gap-6 md:grid-cols-[1fr_0.85fr]">
                <div>
                  <span className="inline-flex rounded-full bg-orange-500 px-3 py-1.5 text-[9px] font-black uppercase tracking-[0.15em] text-white shadow-sm">
                    {hero.eyebrow}
                  </span>

                  <h1 className="mt-4 max-w-xl text-4xl font-black leading-[1.02] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
                    {hero.title}
                  </h1>

                  <p className="mt-4 max-w-lg text-sm leading-6 text-slate-600 sm:text-base">
                    {hero.text}
                  </p>

                  <div className="mt-6 flex flex-wrap gap-3">
                    <button
                      type="button"
                      onClick={handleHeroButton}
                      className="rounded-full bg-orange-500 px-6 py-3 text-[10px] font-black uppercase tracking-wide text-white shadow-lg shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-orange-600"
                    >
                      {hero.button}
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        document
                          .getElementById("flash-sales")
                          ?.scrollIntoView({ behavior: "smooth" })
                      }
                      className="rounded-full border border-slate-200 bg-white px-6 py-3 text-[10px] font-black uppercase tracking-wide text-slate-700 shadow-sm transition hover:border-orange-300 hover:text-orange-600"
                    >
                      {language === "sw"
                        ? "ANGALIA BIDHAA"
                        : "EXPLORE PRODUCTS"}
                    </button>
                  </div>

                  <div className="mt-7 flex flex-wrap gap-5 text-[10px] font-bold text-slate-500">
                    <span>✓ {language === "sw" ? "Bidhaa nyingi" : "Many products"}</span>
                    <span>✓ {language === "sw" ? "Bei nzuri" : "Great prices"}</span>
                    <span>✓ {language === "sw" ? "Delivery rahisi" : "Easy delivery"}</span>
                  </div>
                </div>

                <div className="relative flex min-h-[230px] items-center justify-center">
                  <div className="absolute h-52 w-52 rounded-full bg-white/80 shadow-inner sm:h-64 sm:w-64" />

                  {hero.product && getProductImage(hero.product) ? (
                    <img
                      src={getProductImage(hero.product)}
                      alt={hero.product.name}
                      className="relative z-10 max-h-[245px] w-full object-contain drop-shadow-2xl transition duration-700 sm:max-h-[300px]"
                    />
                  ) : (
                    <div className="relative z-10 flex h-52 w-52 items-center justify-center overflow-hidden rounded-full bg-white shadow-inner sm:h-64 sm:w-64">
                      <img
                        src="/gamora-logo.png"
                        alt="Gamora Online"
                        className="h-24 w-auto object-contain opacity-80"
                      />
                    </div>
                  )}

                  {hero.product && (
                    <div className="absolute bottom-2 right-0 z-20 rounded-2xl border border-white/70 bg-white/90 px-4 py-3 shadow-xl backdrop-blur">
                      <p className="max-w-[150px] truncate text-[10px] font-bold text-slate-700">
                        {hero.product.name}
                      </p>
                      <p className="mt-1 text-sm font-black text-orange-600">
                        {formatCurrency(
                          Number(hero.product.price || 0),
                          currency
                        )}
                      </p>
                    </div>
                  )}
                </div>
              </div>

              <div className="absolute bottom-5 left-6 flex gap-1.5">
                {heroSlides.map((_, index) => (
                  <span
                    key={index}
                    className={`h-1.5 rounded-full transition-all ${
                      index === heroIndex
                        ? "w-7 bg-orange-500"
                        : "w-1.5 bg-slate-300"
                    }`}
                  />
                ))}
              </div>
            </div>

            {/* RIGHT PROMO PANEL */}
            <div className="flex flex-col gap-4">
              <div className="relative overflow-hidden rounded-3xl bg-slate-950 p-5 text-white shadow-xl">
                <div className="absolute -right-10 -top-10 h-28 w-28 rounded-full bg-orange-500/20 blur-2xl" />

                <div className="relative z-10">
                  <div className="flex items-center justify-between">
                    <span className="text-[9px] font-black uppercase tracking-[0.18em] text-orange-400">
                      Flash Deals
                    </span>

                    <span className="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-[9px] font-black tracking-widest">
                      {flashTime}
                    </span>
                  </div>

                  <h3 className="mt-4 text-2xl font-black">
                    {language === "sw"
                      ? "Ofa kali leo"
                      : "Hot deals today"}
                  </h3>

                  <p className="mt-2 text-xs leading-5 text-slate-300">
                    {language === "sw"
                      ? "Pata bidhaa zenye punguzo kabla muda haujaisha."
                      : "Grab selected products before the offers end."}
                  </p>

                  <button
                    type="button"
                    onClick={() =>
                      document
                        .getElementById("flash-sales")
                        ?.scrollIntoView({ behavior: "smooth" })
                    }
                    className="mt-5 w-full rounded-xl bg-orange-500 py-3 text-[10px] font-black uppercase tracking-wide text-white transition hover:bg-orange-600"
                  >
                    {language === "sw" ? "ANGALIA OFA" : "VIEW DEALS"}
                  </button>
                </div>
              </div>

              <div className="grid flex-1 grid-cols-2 gap-4 lg:grid-cols-1">
                {[heroProducts[1], heroProducts[2]]
                  .filter(Boolean)
                  .map((product) => {
                    const image = getProductImage(product);

                    return (
                      <button
                        key={product.id}
                        type="button"
                        onClick={() => router.push(`/product/${product.id}`)}
                        className="group overflow-hidden rounded-3xl border border-slate-100 bg-white text-left shadow-sm transition hover:-translate-y-1 hover:border-orange-200 hover:shadow-lg"
                      >
                        <div className="relative flex h-32 items-center justify-center bg-slate-50 p-3 sm:h-36">
                          {image ? (
                            <img
                              src={image}
                              alt={product.name}
                              className="h-full w-full object-contain transition duration-500 group-hover:scale-105"
                            />
                          ) : (
                            <img
                              src="/gamora-logo.png"
                              alt="Gamora Online"
                              className="h-16 w-auto object-contain opacity-60"
                            />
                          )}

                          {getDiscount(product) > 0 && (
                            <span className="absolute left-2 top-2 rounded-full bg-orange-500 px-2 py-1 text-[8px] font-black text-white">
                              -{getDiscount(product)}%
                            </span>
                          )}
                        </div>

                        <div className="p-4">
                          <p className="line-clamp-1 text-[10px] font-black text-slate-900">
                            {product.name}
                          </p>

                          <p className="mt-1 text-sm font-black text-orange-600">
                            {formatCurrency(
                              Number(product.price || 0),
                              currency
                            )}
                          </p>

                          <span className="mt-2 inline-block text-[8px] font-black uppercase tracking-wide text-slate-400 transition group-hover:text-orange-500">
                            {language === "sw"
                              ? "TAZAMA BIDHAA"
                              : "VIEW PRODUCT"}
                          </span>
                        </div>
                      </button>
                    );
                  })}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* GAMORA PRODUCT HUB */}
      <section id="flash-sales" className="bg-orange-50/60 py-9 sm:py-12">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">

          <div className="rounded-[28px] border border-orange-100 bg-white p-4 shadow-sm sm:p-6">

            <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <div className="flex flex-wrap items-center gap-2">
                  <span className="inline-flex items-center rounded-full bg-orange-500 px-3 py-1.5 text-[9px] font-black uppercase tracking-wide text-white">
                    🔥 {language === "sw" ? "OFERTA KALI ZA LEO" : "TODAY'S HOT DEALS"}
                  </span>

                  <div className="rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-[9px] font-black text-orange-700">
                    {language === "sw" ? "Inaisha baada ya" : "Ends in"}{" "}
                    <span className="ml-1 tracking-widest">
                      {flashTime}
                    </span>
                  </div>
                </div>

                <h2 className="mt-3 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
                  {language === "sw"
                    ? "Gundua bidhaa za Gamora"
                    : "Discover Gamora products"}
                </h2>

                <p className="mt-1 max-w-2xl text-xs leading-5 text-slate-500 sm:text-sm">
                  {language === "sw"
                    ? "Pitia bidhaa zote, ofa za leo na bidhaa zinazopendwa zaidi na wanunuzi."
                    : "Browse all products, today's deals and the items shoppers love most."}
                </p>
              </div>

              <CarouselArrows
                onPrev={() =>
                  flashRef.current?.scrollBy({
                    left: -800,
                    behavior: "smooth",
                  })
                }
                onNext={() =>
                  flashRef.current?.scrollBy({
                    left: 800,
                    behavior: "smooth",
                  })
                }
              />
            </div>

            <div className="mt-6 flex gap-2 overflow-x-auto pb-1 scrollbar-hide">
              {[
                {
                  id: "all",
                  label: language === "sw" ? "BIDHAA ZOTE" : "ALL GAMORA",
                },
                {
                  id: "deals",
                  label: language === "sw" ? "TODAY DEALS" : "TODAY DEALS",
                },
                {
                  id: "thumbs",
                  label:
                    language === "sw"
                      ? "👍 THUMBS UP ITEMS"
                      : "👍 THUMBS UP ITEMS",
                },
              ].map((tab) => {
                const active =
                  (tab.id === "all" && productHubTab === "all") ||
                  (tab.id === "deals" && productHubTab === "deals") ||
                  (tab.id === "thumbs" && productHubTab === "thumbs");

                return (
                  <button
                    key={tab.id}
                    type="button"
                    onClick={() =>
                      setProductHubTab(
                        tab.id as "all" | "deals" | "thumbs"
                      )
                    }
                    className={`shrink-0 rounded-full px-4 py-2.5 text-[10px] font-black uppercase tracking-wide transition sm:px-5 ${
                      active
                        ? "bg-orange-500 text-white shadow-md"
                        : "border border-slate-200 bg-white text-slate-600 hover:border-orange-200 hover:bg-orange-50 hover:text-orange-600"
                    }`}
                  >
                    {tab.label}
                  </button>
                );
              })}
            </div>

            <div className="mt-5">
              {productHubProducts.length ? (
                <Carousel carouselRef={flashRef}>
                  {productHubProducts.map((product, index) => (
                    <ProductCard
                      key={product.id}
                      product={product}
                      addToCart={addToCart}
                      bestSeller={
                        productHubTab === "thumbs" ||
                        Number(product.orders_count || 0) > 0
                      }
                      currency={currency}
                      language={language}
                    />
                  ))}
                </Carousel>
              ) : (
                <EmptySection
                  text={
                    productHubTab === "deals"
                      ? language === "sw"
                        ? "Hakuna ofa kwa sasa."
                        : "No active deals right now."
                      : language === "sw"
                        ? "Hakuna bidhaa kwa sasa."
                        : "No products available right now."
                  }
                />
              )}
            </div>

            <div className="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
              <p className="text-[10px] font-bold text-slate-400">
                {language === "sw"
                  ? `${productHubProducts.length} bidhaa zinaonyeshwa`
                  : `${productHubProducts.length} products displayed`}
              </p>

              <button
                type="button"
                onClick={() =>
                  document
                    .getElementById("products")
                    ?.scrollIntoView({ behavior: "smooth" })
                }
                className="rounded-full bg-slate-950 px-4 py-2 text-[9px] font-black uppercase tracking-wide text-white transition hover:bg-orange-500"
              >
                {language === "sw"
                  ? "ONA BIDHAA ZOTE"
                  : "VIEW ALL PRODUCTS"}
              </button>
            </div>

          </div>
        </div>
      </section>

      {/* TRENDING */}
      <section className="bg-white py-9 sm:py-12">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <div className="flex items-end justify-between gap-4">
            <SectionHeading
              title={language === "sw" ? "Inapendwa sana" : "Trending now"}
              subtitle={
                language === "sw"
                  ? "Bidhaa zinazovutia wanunuzi hivi sasa."
                  : "Products shoppers are loving right now."
              }
            />

            <CarouselArrows
              onPrev={() =>
                trendingRef.current?.scrollBy({
                  left: -700,
                  behavior: "smooth",
                })
              }
              onNext={() =>
                trendingRef.current?.scrollBy({
                  left: 700,
                  behavior: "smooth",
                })
              }
            />
          </div>

          <Carousel carouselRef={trendingRef}>
            {trending.map((product) => (
              <ProductCard
                key={product.id}
                product={product}
                addToCart={addToCart}
                currency={currency}
                language={language}
              />
            ))}
          </Carousel>
        </div>
      </section>

      {/* NEW ARRIVALS */}
      <section id="new-arrivals" className="bg-slate-50 py-9 sm:py-12">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <div className="flex items-end justify-between gap-4">
            <SectionHeading
              title={language === "sw" ? "Bidhaa mpya" : "New arrivals"}
              subtitle={
                language === "sw"
                  ? "Bidhaa mpya kabisa kwenye Gamora Online."
                  : "Fresh products recently added to Gamora Online."
              }
            />

            <CarouselArrows
              onPrev={() =>
                newRef.current?.scrollBy({
                  left: -700,
                  behavior: "smooth",
                })
              }
              onNext={() =>
                newRef.current?.scrollBy({
                  left: 700,
                  behavior: "smooth",
                })
              }
            />
          </div>

          <Carousel carouselRef={newRef}>
            {newArrivals.map((product) => (
              <ProductCard
                key={product.id}
                product={product}
                addToCart={addToCart}
                currency={currency}
                language={language}
              />
            ))}
          </Carousel>
        </div>
      </section>

      {/* BEST SELLERS */}
      <section id="best-sellers" className="bg-white py-9 sm:py-12">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <SectionHeading
            title={language === "sw" ? "Best Sellers" : "Best Sellers"}
            subtitle={
              language === "sw"
                ? "Bidhaa zinazopendwa na kununuliwa zaidi."
                : "Our most loved and purchased products."
            }
          />

          <div className="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6">
            {bestSellers.map((product) => (
              <ProductCard
                key={product.id}
                product={product}
                addToCart={addToCart}
                bestSeller
                currency={currency}
                language={language}
              />
            ))}
          </div>
        </div>
      </section>

      {/* ALL PRODUCTS */}
      <section id="products" className="bg-white py-10 sm:py-14">
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <div className="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading
              title={
                selectedCategory === "All"
                  ? language === "sw"
                    ? "Bidhaa zote"
                    : "All products"
                  : selectedCategory
              }
              subtitle={
                search
                  ? `${filteredProducts.length} ${
                      language === "sw"
                        ? "bidhaa zimepatikana"
                        : "products found"
                    }`
                  : language === "sw"
                  ? "Gundua bidhaa zaidi kutoka Gamora Online."
                  : "Discover more products from Gamora Online."
              }
            />

            {selectedCategory !== "All" && (
              <button
                type="button"
                onClick={() => setSelectedCategory("All")}
                className="rounded-full bg-slate-100 px-4 py-2 text-[10px] font-black text-slate-600 hover:bg-orange-50 hover:text-orange-600"
              >
                {language === "sw"
                  ? "ONDOA FILTER"
                  : "CLEAR FILTER"}
              </button>
            )}
          </div>

          {filteredProducts.length ? (
            <div className="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6">
              {filteredProducts.map((product) => (
                <ProductCard
                  key={product.id}
                  product={product}
                  addToCart={addToCart}
                  currency={currency}
                  language={language}
                />
              ))}
            </div>
          ) : (
            <EmptySection
              text={
                language === "sw"
                  ? "Hakuna bidhaa zilizopatikana."
                  : "No products found."
              }
            />
          )}
        </div>
      </section>

      {/* FOOTER */}
      <footer
        id="footer"
        className="border-t border-slate-800 bg-slate-950 py-12 text-slate-300"
      >
        <div className="mx-auto max-w-[1600px] px-4 sm:px-6 lg:px-8">
          <div className="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <img
                src="/gamora-logo.png"
                alt="Gamora Online"
                className="h-12 w-auto rounded-lg bg-white px-2 object-contain"
              />

              <p className="mt-4 max-w-sm text-xs leading-6 text-slate-400">
                {language === "sw"
                  ? "Gamora Online ni marketplace inayokupa njia rahisi ya kugundua na kuagiza bidhaa mbalimbali."
                  : "Gamora Online is a modern marketplace built to make discovering and ordering products simple."}
              </p>

              <div className="mt-5 flex gap-2">
                <SocialButton label="Facebook" icon={<FaFacebookF />} />
                <SocialButton label="Instagram" icon={<FaInstagram />} />
                <SocialButton label="TikTok" icon={<FaTiktok />} />
              </div>
            </div>

            <FooterColumn
              title={language === "sw" ? "Gamora Online" : "Gamora Online"}
              links={[
                [
                  language === "sw" ? "Nyumbani" : "Home",
                  "/",
                ],
                [
                  language === "sw" ? "Makundi" : "Categories",
                  "#categories",
                ],
                [
                  language === "sw" ? "Ofa" : "Flash Deals",
                  "#flash-sales",
                ],
                [
                  language === "sw" ? "Bidhaa mpya" : "New Arrivals",
                  "#new-arrivals",
                ],
              ]}
            />

            <FooterColumn
              title={language === "sw" ? "Huduma" : "Customer"}
              links={[
                [
                  language === "sw" ? "Akaunti yangu" : "My Account",
                  "/account",
                ],
                [
                  language === "sw" ? "Kikapu" : "Cart",
                  "/cart",
                ],
                [
                  language === "sw" ? "Delivery" : "Delivery",
                  "/delivery",
                ],
                [
                  language === "sw" ? "Checkout" : "Checkout",
                  "/checkout",
                ],
              ]}
            />

            <div>
              <h3 className="text-sm font-black text-white">
                {language === "sw" ? "Wasiliana nasi" : "Contact us"}
              </h3>

              <div className="mt-4 space-y-3 text-xs text-slate-400">
                <p>📍 Dar es Salaam, Tanzania</p>
                <p>✉️ officialgamoraonline@gmail.com</p>
                <p>🌐 gamoraonline.co.tz</p>
              </div>
            </div>
          </div>

          <div className="mt-10 border-t border-white/10 pt-5 text-center text-[10px] text-slate-500">
            © {new Date().getFullYear()} Gamora Online. All rights reserved.
          </div>
        </div>
      </footer>
    </main>
  );
}

function getProductImage(product: Product) {
  return product.images?.[0] || product.image || "";
}

function getDiscount(product: Product) {
  if (
    typeof product.discount === "number" &&
    product.discount > 0
  ) {
    return product.discount;
  }

  if (
    typeof product.oldPrice === "number" &&
    product.oldPrice > product.price
  ) {
    return Math.round(
      ((product.oldPrice - product.price) /
        product.oldPrice) *
        100
    );
  }

  return 0;
}

function SectionHeading({
  title,
  subtitle,
}: {
  title: string;
  subtitle: string;
}) {
  return (
    <div className="flex items-end justify-between gap-4">
      <div>
        <div className="mb-2 flex items-center gap-2">
          <span className="h-1.5 w-8 rounded-full bg-orange-500" />
          <span className="text-[10px] font-black uppercase tracking-[0.18em] text-orange-600">
            Gamora Online
          </span>
        </div>

        <h2 className="text-xl font-black tracking-tight text-slate-950 sm:text-2xl lg:text-3xl">
          {title}
        </h2>

        <p className="mt-1 text-xs leading-5 text-slate-500 sm:text-sm">
          {subtitle}
        </p>
      </div>
    </div>
  );
}

function Carousel({
  carouselRef,
  children,
}: {
  carouselRef: RefObject<HTMLDivElement | null>;
  children: React.ReactNode;
}) {
  return (
    <div
      ref={carouselRef}
      className="mt-3 flex gap-2.5 overflow-x-auto pb-2 scrollbar-hide sm:mt-5 sm:gap-4 sm:pb-4"
    >
      {children}
    </div>
  );
}

function CarouselArrows({
  onPrev,
  onNext,
}: {
  onPrev: () => void;
  onNext: () => void;
}) {
  return (
    <div className="hidden gap-2 sm:flex">
      <button
        type="button"
        onClick={onPrev}
        aria-label="Previous"
        className="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-xl font-bold text-slate-700 shadow-sm transition hover:border-orange-400 hover:text-orange-600 hover:shadow-md"
      >
        ‹
      </button>

      <button
        type="button"
        onClick={onNext}
        aria-label="Next"
        className="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-xl font-bold text-slate-700 shadow-sm transition hover:border-orange-400 hover:text-orange-600 hover:shadow-md"
      >
        ›
      </button>
    </div>
  );
}

function ProductCard({
  product,
  addToCart,
  bestSeller = false,
  currency,
  language,
}: {
  product: Product;
  addToCart: (product: Product) => void;
  bestSeller?: boolean;
  currency: Currency;
  language: Language;
}) {
  const image = getProductImage(product);
  const discount = getDiscount(product);
  const stock = Number(product.stock || 0);
  const [liked, setLiked] = useState(false);

  return (
    <article className="group relative min-w-[150px] max-w-[175px] shrink-0 overflow-hidden rounded-xl border border-[#eeeeee] bg-white shadow-none transition duration-200 hover:-translate-y-0.5 hover:border-[#E30613] hover:shadow-md sm:min-w-[205px] sm:max-w-none sm:rounded-2xl sm:shadow-sm lg:min-w-0">
      <div className="absolute left-3 top-3 z-20 flex flex-col gap-1.5">
        {discount > 0 && (
          <span className="w-fit rounded-full bg-orange-500 px-2.5 py-1 text-[9px] font-black text-white shadow-sm">
            -{discount}%
          </span>
        )}

        {bestSeller && (
          <span className="w-fit rounded-full bg-teal-700 px-2.5 py-1 text-[8px] font-black uppercase tracking-wide text-white">
            {language === "sw" ? "Inauzwa sana" : "Best seller"}
          </span>
        )}
      </div>

      <div className="absolute right-3 top-3 z-20 flex flex-col gap-2">
        <button
          type="button"
          onClick={(e) => {
            e.stopPropagation();
            setLiked((value) => !value);
          }}
          className={`flex h-9 w-9 items-center justify-center rounded-full border bg-white/95 text-lg shadow-sm backdrop-blur transition hover:scale-110 ${
            liked
              ? "border-red-200 bg-red-50 text-red-500"
              : "border-slate-100 text-slate-500 hover:border-red-200 hover:bg-red-50 hover:text-red-500"
          }`}
          aria-label={liked ? "Unlike product" : "Like product"}
          aria-pressed={liked}
        >
          {liked ? "♥" : "♡"}
        </button>

        <button
          type="button"
          onClick={() => addToCart(product)}
          className="flex h-8 w-8 items-center justify-center rounded-full border border-slate-100 bg-white/95 sm:h-9 sm:w-9 text-sm shadow-sm backdrop-blur transition hover:scale-105 hover:border-orange-200 hover:bg-orange-50"
          aria-label="Add to cart"
        >
          🛒
        </button>
      </div>

      <button
        type="button"
        onClick={() =>
          window.location.href = `/product/${product.id}`
        }
        className="block w-full text-left"
      >
        <div className="flex h-[118px] items-center justify-center overflow-hidden bg-[#F8F8F8] sm:h-[180px] lg:h-[220px]">
          {image ? (
            <img
              src={image}
              alt={product.name}
              loading="lazy"
              className="h-full w-full object-contain p-1.5 transition duration-300 group-hover:scale-105 sm:p-2"
            />
          ) : (
            <img
              src="/gamora-logo.png"
              alt="Gamora Online"
              className="h-16 w-auto opacity-30"
            />
          )}
        </div>

        <div className="px-2 pt-2 sm:px-3.5 sm:pt-3">
          <p className="min-h-[34px] line-clamp-2 text-[11px] font-semibold leading-4 text-[#111111] sm:min-h-[38px] sm:text-sm sm:leading-5">
            {product.name}
          </p>

          <div className="mt-2 flex items-end justify-between gap-2">
            <div>
              <p className="text-sm font-black text-[#E30613] sm:text-lg">
                {formatCurrency(
                  Number(product.price || 0),
                  currency
                )}
              </p>

              {typeof product.oldPrice === "number" &&
                product.oldPrice > Number(product.price || 0) && (
                  <p className="text-[10px] text-slate-400 line-through">
                    {formatCurrency(product.oldPrice, currency)}
                  </p>
                )}
            </div>

            {stock > 0 && stock <= 5 && (
              <span className="text-[9px] font-bold text-red-500">
                {language === "sw"
                  ? `Zimebaki ${stock}`
                  : `${stock} left`}
              </span>
            )}
          </div>
        </div>
      </button>

      <div className="px-2 pb-2.5 pt-2 sm:px-3.5 sm:pb-3.5 sm:pt-3">
        <button
          type="button"
          onClick={() => addToCart(product)}
          className="w-full rounded-lg bg-[#E30613] py-2 text-[9px] font-black uppercase tracking-wide text-white transition hover:bg-[#c90511] active:scale-[0.98] sm:rounded-xl sm:py-2.5 sm:text-[10px]"
        >
          {language === "sw"
            ? "ONGEZA KIKAPUNI"
            : "ADD TO CART"}
        </button>
      </div>
    </article>
  );
}

function EmptySection({
  text,
}: {
  text: string;
}) {
  return (
    <div className="mt-6 rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm font-medium text-slate-400">
      {text}
    </div>
  );
}


function FooterColumn({
  title,
  links,
}: {
  title: string;
  links: [string, string][];
}) {
  return (
    <div>
      <h3 className="text-sm font-black text-[#7C2D12]">
        {title}
      </h3>

      <div className="mt-4 space-y-3">
        {links.map(([label, href]) => (
          <a
            key={`${label}-${href}`}
            href={href}
            className="block text-xs font-medium text-slate-200 transition hover:text-[#7C2D12]"
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  );
}

function SocialButton({
  label,
  icon,
}: {
  label: string;
  icon: React.ReactNode;
}) {
  return (
    <a
      href="#"
      aria-label={label}
      className="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-sm text-[#7C2D12] transition hover:bg-white/20"
    >
      {icon}
    </a>
  );
}
