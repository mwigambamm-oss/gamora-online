      ? Math.round(
          ((product.oldPrice - product.price) / product.oldPrice) * 100
        )
      : 0;

  return (
    <article className="group overflow-hidden rounded-2xl border border-purple-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-purple-400 hover:shadow-xl">

      {/* PRODUCT IMAGE */}
