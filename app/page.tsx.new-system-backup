function ProductCard({
  product,
  addToCart,
  bestSeller = false,
  currency,
  language,
}: {
  product: Product;
  addToCart: (product: Product) => void;
  bestSeller?: boolean;
  currency: Currency;
  language: Language;
}) {
  const image = getProductImage(product);
  const discount = getDiscount(product);
  const stock = Number(product.stock || 0);
  return (
    <article className="group relative min-w-[145px] max-w-[165px] shrink-0 overflow-hidden rounded-md border border-slate-100 bg-white transition duration-150 hover:border-[#E30613] sm:min-w-[185px] sm:max-w-none lg:min-w-0">
      <div className="absolute left-2 top-2 z-20 flex flex-col gap-1.5">
        {discount > 0 && (
          <span className="w-fit rounded-sm bg-[#E30613] px-1.5 py-0.5 text-[8px] font-bold text-white">
            -{discount}%
          </span>
        )}

        {bestSeller && (
          <span className="w-fit rounded-sm bg-[#172033] px-1.5 py-0.5 text-[7px] font-bold uppercase tracking-wide text-white">
            {language === "sw" ? "Inauzwa sana" : "Best seller"}
          </span>
        )}
      </div>

      <div className="absolute right-2 top-2 z-20 flex flex-col gap-2">
        <button
          type="button"
          onClick={() => addToCart(product)}
          className="flex h-7 w-7 items-center justify-center rounded-full border border-slate-100 bg-white/95 text-xs shadow-sm backdrop-blur transition hover:scale-105 hover:border-orange-200 hover:bg-orange-50"
          aria-label="Add to cart"
        >
          🛒
        </button>
      </div>

      <button
        type="button"
        onClick={() =>
          window.location.href = `/product/${product.id}`
        }
        className="block w-full text-left"
      >
        <div className="flex h-[150px] items-center justify-center overflow-hidden bg-white sm:h-[190px] lg:h-[205px]">
          {image ? (
            <img
              src={image}
              alt={product.name}
              loading="lazy"
              className="h-full w-full object-contain p-1.5 transition duration-300 group-hover:scale-[1.02]"
            />
          ) : (
            <img
              src="/gamora-logo.png"
              alt="Gamora Online"
              className="h-16 w-auto opacity-30"
            />
          )}
        </div>

        <div className="px-2 pt-2">
          <p className="min-h-[30px] line-clamp-2 text-[12px] font-medium leading-[15px] text-[#111827]">
            {product.name}
          </p>

          <div className="mt-2 flex items-end justify-between gap-2">
            <div>
              <p className="text-[15px] font-extrabold text-[#E30613]">
                {formatCurrency(
                  Number(product.price || 0),
                  currency
                )}
              </p>

              {typeof product.oldPrice === "number" &&
                product.oldPrice > Number(product.price || 0) && (
                  <p className="text-[10px] text-slate-400 line-through">
                    {formatCurrency(product.oldPrice, currency)}
                  </p>
                )}
            </div>

            {stock > 0 && stock <= 5 && (
              <span className="text-[9px] font-bold text-red-500">
                {language === "sw"
                  ? `Zimebaki ${stock}`
                  : `${stock} left`}
              </span>
            )}
          </div>
        </div>
      </button>

      <div className="px-2 pb-2 pt-1.5">
        <button
          type="button"
          onClick={() => addToCart(product)}
          className="w-full rounded-md bg-[#E30613] py-1.5 text-[9px] font-bold uppercase tracking-wide text-white transition hover:bg-[#c90511] active:scale-[0.98]"
        >
          {language === "sw"
            ? "ONGEZA KIKAPUNI"
            : "ADD TO CART"}
        </button>
      </div>
    </article>
  );
}

