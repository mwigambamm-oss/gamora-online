      {/* HERO */}
      <section className="mx-auto max-w-7xl px-4 py-5">

        <div className="overflow-hidden rounded-xl bg-gradient-to-r from-orange-600 via-orange-500 to-yellow-400">

          <div className="grid items-center gap-8 px-8 py-14 md:grid-cols-2 md:px-16">

            <div className="text-white">

              <span className="rounded-full bg-white/20 px-4 py-2 text-sm font-semibold">
