      {/* HEADER */}
      <header className="sticky top-0 z-50 bg-white shadow-md">

        <div className="mx-auto flex max-w-7xl items-center gap-4 px-4 py-4">

          {/* LOGO */}
          <div className="min-w-fit">
            <h1 className="text-2xl font-black text-orange-600">
