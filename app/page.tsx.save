            </h1>

            <p className="text-xs font-semibold tracking-widest text-gray-500">
              ONLINE
            </p>
          </div>

          {/* SEARCH */}
          <div className="flex flex-1 items-center rounded-md border border-gray-300 bg-gray-50 px-4">

