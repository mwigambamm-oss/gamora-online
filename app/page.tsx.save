    );

    cart.push({
      id: product.id,
      name: product.name,
      price: product.price,
      image: product.image,
      quantity: 1,
    });

    localStorage.setItem(
      "gamora_cart",
      JSON.stringify(cart)
    );

    alert(`${product.name} added to cart!`);
  }}
  className="mt-4 w-full rounded-md bg-orange-600 px-4 py-3 font-bold text-white transition hover:bg-orange-700"
>
  Add to Cart
</button>                    Add to Cart
