export default function Home() {
  const [products, setProducts] = useState<any[]>([]);

  useEffect(() => {
    const savedProducts = localStorage.getItem("gamora_products");

    if (savedProducts) {
      setProducts(JSON.parse(savedProducts));
    }
  }, []);  return (
    <main className="min-h-screen bg-gray-100">

