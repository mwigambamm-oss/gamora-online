    </span>
  )}

  {product.oldPrice > product.price && (
    <span className="absolute left-2 top-2 rounded-full bg-red-500 px-3 py-1 text-xs font-bold text-white">
      SALE
    </span>
  )}

</div>
                </div>

                <div className="p-4">

