"use client";

import { useEffect, useState } from "react";
import { getProductById, getProducts } from "@/lib/products";

type Product = {
  id: number;
  name: string;
  price: number;
  oldPrice?: number;
  category?: string;
  stock: number;
  description?: string;
  image?: string;
  images?: string[];
  colors?: string[];
  sizes?: string[];
};

export default function ProductPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const [product, setProduct] = useState<Product | null>(null);
  const [related, setRelated] = useState<Product[]>([]);
  const [activeImage, setActiveImage] = useState(0);
const [touchStart, setTouchStart] = useState<number | null>(null);
const [touchEnd, setTouchEnd] = useState<number | null>(null);

  useEffect(() => {
    async function load() {
      const { id } = await params;

      const item = await getProductById(Number(id));
      setProduct(item);

      const all = await getProducts();

      setRelated(
        all
          .filter((p) => p.id !== Number(id))
          .slice(0, 4)
      );
    }

    load();
  }, [params]);

  useEffect(() => {
    if (!product) return;

    const carouselImages =
      product.images && product.images.length
        ? product.images
        : product.image
        ? [product.image]
        : [];

    if (carouselImages.length <= 1) return;

    const timer = setInterval(() => {
      setActiveImage((current) =>
        current === carouselImages.length - 1 ? 0 : current + 1
      );
    }, 4000);

    return () => clearInterval(timer);
  }, [product]);

  if (!product) {
    return (
      <div className="p-10 text-center font-bold">
        Loading...
      </div>
    );
  }

  const images =
  product.images && product.images.length
    ? product.images
    : product.image
    ? [product.image]
    : [];

  return (
    <main className="min-h-screen bg-white p-4 md:p-8">

      <div className="mx-auto grid max-w-6xl gap-8 rounded-3xl bg-white md:grid-cols-2">

        {/* IMAGE CAROUSEL */}

<div
  className="relative h-[380px] overflow-hidden rounded-2xl bg-slate-50"
  onTouchStart={(e) => setTouchStart(e.touches[0].clientX)}
  onTouchMove={(e) => setTouchEnd(e.touches[0].clientX)}
  onTouchEnd={() => {
    if (touchStart === null || touchEnd === null) return;

     const distance = touchStart - touchEnd;

    if (Math.abs(distance) > 50) {
      setActiveImage((current) =>
        distance > 0
          ? current === images.length - 1 ? 0 : current + 1
          : current === 0 ? images.length - 1 : current - 1
      );
    }

    setTouchStart(null);
    setTouchEnd(null);
  }}
>

  <div
    className="flex h-full transition-transform duration-300"
    style={{
      transform: `translateX(-${activeImage * 100}%)`,
    }}
  >

    {images.map((img, index) => (
      <div
        key={index}
        className="flex min-w-full items-center justify-center"
      >
        <img
          src={img}
          alt={product.name}
          className="h-full w-full object-contain"
        />
      </div>
    ))}

   </div>

</div>

{/* DOTS */}

 <div className="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5">
    {images.map((_, index) => (
      <span
        key={index}
        className={`h-2 w-2 rounded-full border border-white ${
          activeImage === index ? "bg-white" : "bg-white/40"
        }`}
      />
    ))}
  </div>

  </div>

  {/* DETAILS */}

        <div className="p-2 text-left font-sans">

          <h1 className="text-[18px] font-bold font-sans text-slate-900">
  {product.name}
</h1>

          <div className="mt-3 text-[13px] text-slate-400">
  ⭐⭐⭐⭐⭐
</div>


          <div className="mt-5 flex items-center gap-3">

            <span className="text-[14px] font-sans text-sky-700">
              TZS {product.price.toLocaleString()}
            </span>

            {product.oldPrice && (
              <span className="text-[13px] font-sans text-slate-400 line-through">
                TZS {product.oldPrice.toLocaleString()}
              </span>
            )}

          </div>


          <p className="mt-4 text-[13px] font-bold leading-5 text-slate-400">
  {product.description}
</p>
{/* STOCK */}

<div className="mt-3 text-[13px] font-bold text-green-600">
  ✓ In Stock ({product.stock})
</div>

{/* COLORS */}

{product.colors && product.colors.length > 0 && (
  <div className="mt-3">

    <p className="mb-2 text-xs font-bold text-slate-500">
      Color
    </p>

    <div className="flex flex-wrap gap-2">
      {product.colors.map((color) => (
        <span
          key={color}
          className="rounded-lg border px-3 py-1 text-[13px] font-bold text-slate-600"
        >
          {color}
        </span>
      ))}
    </div>

  </div>
)}


{/* SIZES */}

{product.sizes && product.sizes.length > 0 && (
  <div className="mt-5">

    <p className="mb-2 text-xs font-bold text-slate-500">
      Size
    </p>

    <div className="flex flex-wrap gap-2">
      {product.sizes.map((size) => (
        <span
          key={size}
          className="rounded-lg border px-3 py-1 text-xs font-bold text-slate-600"
        >
          {size}
        </span>
      ))}
    </div>

  </div>
)}


{/* QUANTITY */}

<div className="mt-5">

  <p className="mb-2 text-xs font-bold text-slate-500">
    Quantity
  </p>

  <div className="flex w-fit items-center overflow-hidden rounded-lg border">

    <button className="px-2.5 py-1 text-[13px] font-bold">
      −
    </button>

    <span className="px-3 text-[13px] font-bold">
      1
    </span>

    <button className="px-2.5 py-1 text-[13px] font-bold">
      +
    </button>

  </div>

</div>

{/* ACTION BUTTONS */}

<div className="mt-4 grid grid-cols-3 gap-2">

  <button
    className="rounded-lg bg-sky-700 px-2 py-2 text-[13px] font-bold text-white"
  >
    🛒 Cart
  </button>


  <button
    className="rounded-lg border border-sky-700 px-3 py-3 text-xs font-bold text-sky-700"
  >
    ⚡ Buy
  </button>


  <a
    href={`https://wa.me/255798555221`}
    className="rounded-lg bg-green-600 px-2 py-2 text-center text-[13px] font-bold text-white"
  >
    💬 WhatsApp
  </a>

        </div>

      </div>


      {/* RELATED PRODUCTS */}

      <section className="mx-auto mt-10 max-w-6xl">

        <h2 className="mb-5 text-xl font-bold">
          Related Products
        </h2>

        <div className="grid grid-cols-2 gap-4 md:grid-cols-4">

          {related.map((item) => (
            <div
              key={item.id}
              className="rounded-xl border p-3"
            >
              <img
                src={item.image}
                className="h-40 w-full object-contain"
                alt={item.name}
              />

              <p className="mt-2 text-sm font-bold">
                {item.name}
              </p>

              <p className="text-sm text-sky-700">
                TZS {item.price.toLocaleString()}
              </p>

            </div>
          ))}

        </div>

      </section>

    </main>
  );
}
