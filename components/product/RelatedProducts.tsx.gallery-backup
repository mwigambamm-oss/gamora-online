"use client";

import Link from "next/link";

type Product = {
  id: number;
  name: string;
  price: number;
  oldPrice?: number;
  image?: string;
  images?: string[];
  category?: string;
};

export default function RelatedProducts({
  products,
}: {
  products: Product[];
}) {
  if (!products || products.length === 0) return null;

  return (
    <section className="mt-7 border-t border-[#eee] pt-5 sm:mt-8 sm:pt-6">
      <h2 className="mb-3 text-sm font-bold text-[#374151] sm:mb-4 sm:text-base">
        You May Also Like
      </h2>

      <div className="grid grid-cols-2 gap-x-2 gap-y-4 sm:grid-cols-3 sm:gap-x-3 sm:gap-y-5 lg:grid-cols-5 xl:grid-cols-6">
        {products.map((product) => {
          const image =
            product.images?.[0] ||
            product.image ||
            "";

          return (
            <Link
              key={product.id}
              href={`/product/${product.id}`}
              className="group min-w-0 overflow-hidden bg-white"
            >
              {/* IMAGE AREA */}
              <div className="relative flex h-[175px] w-full items-center justify-center overflow-hidden bg-white sm:h-[195px] lg:h-[210px]">
                {image ? (
                  <img
                    src={image}
                    alt={product.name}
                    loading="lazy"
                    className="block h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.025]"
                  />
                ) : (
                  <div className="flex h-full w-full items-center justify-center text-xs text-gray-400">
                    No Image
                  </div>
                )}
              </div>

              {/* SMALL PRODUCT INFO */}
              <div className="px-0.5 pt-1 sm:px-1 sm:pt-1.5">
                <h3 className="line-clamp-2 min-h-[28px] text-[10px] font-medium leading-[14px] text-[#222] sm:min-h-[30px] sm:text-[11px] sm:leading-[15px]">
                  {product.name}
                </h3>

                <p className="mt-0.5 text-[11px] font-bold text-[#e30613] sm:text-xs">
                  TZS {Number(product.price).toLocaleString()}
                </p>

                {typeof product.oldPrice === "number" &&
                  product.oldPrice > product.price && (
                    <p className="text-[8px] leading-3 text-gray-400 line-through sm:text-[9px]">
                      TZS {product.oldPrice.toLocaleString()}
                    </p>
                  )}
              </div>
            </Link>
          );
        })}
      </div>
    </section>
  );
}
